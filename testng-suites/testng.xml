<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Delta Pharmacy Automation Suite" parallel="tests" thread-count="3" verbose="1">

    <!-- Suite-level parameters -->
    <parameter name="env" value="testing"/>
    <parameter name="browser" value="chrome"/>

    <!-- Listeners -->
    <listeners>
        <listener class-name="com.pharmacy.automation.listeners.TestListener"/>
        <listener class-name="com.pharmacy.automation.listeners.SuiteListener"/>
        <listener class-name="com.pharmacy.automation.listeners.ExtentReportListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- Chrome Tests -->
    <test name="Chrome - All Tests" parallel="classes" thread-count="2">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.pharmacy.automation.tests.LoginTests"/>
            <class name="com.pharmacy.automation.tests.ProductTests"/>
            <class name="com.pharmacy.automation.tests.OrderTests"/>
            <class name="com.pharmacy.automation.tests.PrescriptionTests"/>
            <class name="com.pharmacy.automation.tests.E2ETests"/>
        </classes>
    </test>

    <!-- Firefox Tests -->
    <test name="Firefox - All Tests" parallel="classes" thread-count="2">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.pharmacy.automation.tests.LoginTests"/>
            <class name="com.pharmacy.automation.tests.ProductTests"/>
            <class name="com.pharmacy.automation.tests.OrderTests"/>
        </classes>
    </test>

    <!-- Edge Tests -->
    <test name="Edge - All Tests" parallel="classes" thread-count="2">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.pharmacy.automation.tests.LoginTests"/>
            <class name="com.pharmacy.automation.tests.ProductTests"/>
        </classes>
    </test>

</suite>