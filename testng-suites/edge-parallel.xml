<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Edge Parallel Execution Suite" parallel="tests" thread-count="2" verbose="1">
    <parameter name="env" value="testing"/>
    <parameter name="browser" value="edge"/>

    <listeners>
        <listener class-name="com.pharmacy.automation.listeners.TestListener"/>
        <listener class-name="com.pharmacy.automation.listeners.ExtentReportListener"/>
    </listeners>

    <test name="Edge - Login Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.pharmacy.automation.tests.LoginTests"/>
        </classes>
    </test>

    <test name="Edge - Product Tests">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.pharmacy.automation.tests.ProductTests"/>
        </classes>
    </test>
</suite>