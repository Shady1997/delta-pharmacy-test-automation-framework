<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="End-to-End Test Suite" verbose="1">
    <parameter name="env" value="testing"/>
    <parameter name="browser" value="chrome"/>

    <listeners>
        <listener class-name="com.pharmacy.automation.listeners.TestListener"/>
        <listener class-name="com.pharmacy.automation.listeners.ExtentReportListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="End-to-End Scenarios">
        <classes>
            <class name="com.pharmacy.automation.tests.E2ETests"/>
        </classes>
    </test>
</suite>